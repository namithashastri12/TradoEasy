# TradoEasy Backend Configuration

# Application Mode: 'live' uses real FYERS API data; 'demo' uses simulated market data
APP_MODE=demo

# FYERS Plan: 'prime' unlocks up to 5,000 live WebSocket symbols (all 208 stocks simultaneously)
# 'free' caps WebSocket to 100 symbols
FYERS_PLAN=prime

# FYERS API V3 Credentials
# Client ID format is typically [USER_ID]-[APP_TYPE], e.g. XC12345-100
FYERS_CLIENT_ID=your_fyers_client_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Optional: Direct FYERS Access Token (valid for 1 trading day)
# If provided, the backend can connect directly without going through the web login flow
FYERS_ACCESS_TOKEN=

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Scanner & Monitoring Parameters
STALE_DATA_TIMEOUT_SECONDS=20
RVOL_THRESHOLD=2.0
AUTO_REFRESH_INTERVAL_SECONDS=60
